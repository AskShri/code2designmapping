{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "code2design",
          "version": "0.5.2",
          "informationUri": "https://github.com/AskShri/code2designmapping",
          "rules": [
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
              "shortDescription": {
                "text": "Entry point without a detected authentication control (review)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/306.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-306",
                  "STRIDE:SE"
                ],
                "security-severity": "1.0"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "c2d/unauthenticated_entry_point",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "no authentication control detected on GET / (CWE-306). Applies to: GET /."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 7
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:nmllc234pc"
          },
          "properties": {
            "dfdElements": [
              "ep:xduqfwu3cx"
            ],
            "stride": [
              "S",
              "E"
            ]
          }
        }
      ]
    }
  ]
}
