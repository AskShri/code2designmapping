{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "code2design",
          "version": "0.5.2",
          "informationUri": "https://github.com/AskShri/code2designmapping",
          "rules": [
            {
              "id": "c2d/permissive_cors",
              "name": "PermissiveCors",
              "shortDescription": {
                "text": "Permissive cross-origin policy"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/942.html",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-942",
                  "STRIDE:I"
                ],
                "security-severity": "5.0"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "c2d/permissive_cors",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "cors() with default or wildcard origin (CWE-942). Applies to: backend."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/server.js",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 18
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:pn4remmnjh"
          },
          "properties": {
            "dfdElements": [
              "proc:nmmdbtjh6y"
            ],
            "stride": [
              "I"
            ]
          }
        }
      ]
    }
  ]
}
