                "text": "Hard-coded or committed credentials"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "STRIDE:IE"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
              "shortDescription": {
                "text": "Entry point without a detected authentication control (review)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/306.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-306",
                  "STRIDE:SE"
                ],
                "security-severity": "1.0"
              }
            },
            {
              "id": "c2d/unencrypted_transport",
              "name": "UnencryptedTransport",
              "shortDescription": {
                "text": "Cleartext transport to a non-local host"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-319",
                  "STRIDE:TI"
                ],
                "security-severity": "5.0"
              }
            }
          ]
        }
