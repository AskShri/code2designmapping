              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "STRIDE:IE"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
