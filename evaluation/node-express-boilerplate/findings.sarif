{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "code2design",
          "version": "0.5.0",
          "informationUri": "https://github.com/AskShri/code2designmapping",
          "rules": [
            {
              "id": "c2d/permissive_cors",
              "name": "PermissiveCors",
              "shortDescription": {
                "text": "Permissive cross-origin policy"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/942.html",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-942",
                  "STRIDE:I"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "c2d/plaintext_credentials",
              "name": "PlaintextCredentials",
              "shortDescription": {
                "text": "Hard-coded or committed credentials"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "STRIDE:IE"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
              "shortDescription": {
                "text": "Entry point without a detected authentication control (review)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/306.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-306",
                  "STRIDE:SE"
                ],
                "security-severity": "1.0"
              }
            }
          ]
        }
