{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "code2design",
          "version": "0.5.1",
          "informationUri": "https://github.com/AskShri/code2designmapping",
          "rules": [
            {
              "id": "c2d/debug_mode_enabled",
              "name": "DebugModeEnabled",
              "shortDescription": {
                "text": "Debug mode enabled on the application server"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/489.html",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-489",
                  "STRIDE:IE"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
              "shortDescription": {
                "text": "Entry point without a detected authentication control (review)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/306.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-306",
                  "STRIDE:SE"
                ],
                "security-severity": "1.0"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "c2d/unauthenticated_entry_point",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "no authentication control detected on GET / (CWE-306). Applies to: GET /."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 8
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:brjex7mmr2"
          },
          "properties": {
            "dfdElements": [
              "ep:ihu4cujw3c"
            ],
            "stride": [
              "S",
              "E"
            ]
          }
        },
        {
          "ruleId": "c2d/debug_mode_enabled",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "debug=True on the application server (CWE-489). Applies to: web."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:zetf6lwwmt"
          },
          "properties": {
            "dfdElements": [
              "proc:i2fxwodvr3"
            ],
            "stride": [
              "I",
              "E"
            ]
          }
        }
      ]
    }
  ]
}
