{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "code2design",
          "version": "0.5.1",
          "informationUri": "https://github.com/AskShri/code2designmapping",
          "rules": [
            {
              "id": "c2d/plaintext_credentials",
              "name": "PlaintextCredentials",
              "shortDescription": {
                "text": "Hard-coded or committed credentials"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "STRIDE:IE"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "c2d/unauthenticated_entry_point",
              "name": "UnauthenticatedEntryPoint",
              "shortDescription": {
                "text": "Entry point without a detected authentication control (review)"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/306.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-306",
                  "STRIDE:SE"
                ],
                "security-severity": "1.0"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///"
        }
      },
      "results": [
        {
          "ruleId": "c2d/plaintext_credentials",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "MYSQL_ROOT_PASSWORD_FILE set in compose service 'db' (CWE-798). Applies to: compose-nginx-flask-mysql."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "compose.yaml",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 22,
                  "endLine": 22
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:ahcgvkrbcl"
          },
          "properties": {
            "dfdElements": [
              "proc:jh7cg767gk"
            ],
            "stride": [
              "I",
              "E"
            ]
          }
        },
        {
          "ruleId": "c2d/unauthenticated_entry_point",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "no authentication control detected on GET / (CWE-306). Applies to: GET /."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/hello.py",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 36,
                  "endLine": 37
                }
              }
            }
          ],
          "partialFingerprints": {
            "c2dWeaknessId": "wk:lofhzc4mhu"
          },
          "properties": {
            "dfdElements": [
              "ep:olb7e5a6fp"
            ],
            "stride": [
              "S",
              "E"
            ]
          }
        }
      ]
    }
  ]
}
