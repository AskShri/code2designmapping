{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2design.dev/schema/dfd-ir.schema.json",
  "title": "code2design intermediate representation (DFD IR)",
  "description": "Canonical, renderer-independent model of a system's data flow design (IR 0.2). Every element carries evidence (file, lines, detector, content hash). Elements with origin 'inferred' carry confidence and rationale; 'declared' elements come from human overrides. Assets, threat agents, controls, weaknesses and trust boundaries are first-class so the model can drive STRIDE-per-element analysis and a control-path traceability matrix.",
  "type": "object",
  "required": [
    "version",
    "provenance",
    "processes",
    "entities",
    "stores",
    "boundaries",
    "flows",
    "entry_points",
    "controls",
    "weaknesses",
    "schemas",
    "gaps",
    "assets",
    "threat_agents"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.2"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/store"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry_point"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weakness"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_schema"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "threat_agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threat_agent"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "description": "Stable content-addressed id: <kind>:<base32(sha256(identity tuple))[:10]>",
      "pattern": "^(proc|ext|store|bnd|flow|ep|ctl|wk|sch|asset|agent):[a-z2-7]{10}$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "observed",
        "inferred",
        "declared"
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "grpc",
        "graphql",
        "websocket",
        "amqp",
        "kafka",
        "sqs",
        "pubsub",
        "sql",
        "redis",
        "mongo",
        "file",
        "s3",
        "smtp",
        "cli",
        "in_process",
        "unknown"
      ]
    },
    "technology": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "sqlite",
        "mssql",
        "sql",
        "mongodb",
        "dynamodb",
        "redis",
        "memcached",
        "elasticsearch",
        "kafka",
        "rabbitmq",
        "sqs",
        "s3",
        "gcs",
        "filesystem",
        "unknown"
      ],
      "description": "'sql' means a relational database whose engine is chosen by configuration; see candidate_engines."
    },
    "data_class": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "pii",
        "financial",
        "health",
        "credential",
        "secret",
        "unknown"
      ]
    },
    "control_kind": {
      "type": "string",
      "enum": [
        "authn",
        "authz",
        "input_validation",
        "rate_limit",
        "tls",
        "encryption_at_rest",
        "signing",
        "audit_log",
        "csrf",
        "cors",
        "security_headers"
      ]
    },
    "boundary_kind": {
      "type": "string",
      "enum": [
        "internet",
        "network_segment",
        "host",
        "container",
        "process",
        "iam_role",
        "auth_context",
        "repository"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line",
        "detector"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "description": "Fully qualified symbol, path::name"
        },
        "detector": {
          "type": "string",
          "description": "Detector name and version, e.g. express-routes@1.2"
        },
        "fact_id": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "description": "sha256 of the referenced span's text with whitespace normalized; lets verify detect changed code behind unchanged line numbers",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidenced": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "identity": {
          "type": "array",
          "description": "Identity tuple the id was hashed from, kept in the clear for debugging.",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "if": {
        "properties": {
          "origin": {
            "const": "inferred"
          }
        }
      },
      "then": {
        "required": [
          "confidence",
          "rationale"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "tool_version",
        "commit",
        "generated_from",
        "detectors"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "generated_from": {
          "type": "string",
          "description": "Repository URL or local path identifier"
        },
        "detectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "llm": {
          "type": "object",
          "required": [
            "model",
            "prompt_hash"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "prompt_hash": {
              "type": "string"
            },
            "proposals_accepted": {
              "type": "integer",
              "minimum": 0
            },
            "proposals_rejected": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "overrides_file": {
          "type": "string"
        },
        "input_hashes": {
          "type": "object",
          "description": "repo-relative path -> sha256 of file content, for every file that produced a fact",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scope and depth of analysis, recorded so the model states what it covers",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "out_of_scope_elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "process": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "level",
            "module"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Derived from the code identifier"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "parent": {
              "$ref": "#/$defs/id"
            },
            "module": {
              "type": "string",
              "description": "Repository-relative module or package path"
            },
            "description": {
              "type": "string"
            },
            "code_name": {
              "type": "string",
              "description": "The code-derived name, kept when an override renames the element"
            }
          }
        }
      ]
    },
    "entity": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "system",
                "llm_api"
              ]
            },
            "host": {
              "type": "string"
            },
            "sdk_service": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "code_name": {
              "type": "string",
              "description": "The code-derived name, kept when an override renames the element"
            }
          }
        }
      ]
    },
    "store": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "technology",
            "data_classes",
            "encryption_at_rest"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "technology": {
              "$ref": "#/$defs/technology"
            },
            "logical_name": {
              "type": "string",
              "description": "Table, bucket, topic, collection, key prefix"
            },
            "data_classes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/data_class"
              }
            },
            "description": {
              "type": "string"
            },
            "encryption_at_rest": {
              "$ref": "#/$defs/encryption_at_rest"
            },
            "code_name": {
              "type": "string",
              "description": "The code-derived name, kept when an override renames the element"
            },
            "candidate_engines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/technology"
              },
              "description": "For technology 'sql': the engines the deployment or configuration can select"
            }
          }
        }
      ]
    },
    "boundary": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "kind",
            "contains"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/boundary_kind"
            },
            "contains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            },
            "parent": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "data_classes"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_class"
          }
        }
      }
    },
    "flow": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "source",
            "target",
            "protocol",
            "direction",
            "authentication",
            "encryption",
            "crosses_boundary",
            "controls"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/id"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "protocol": {
              "$ref": "#/$defs/protocol"
            },
            "direction": {
              "type": "string",
              "enum": [
                "one_way",
                "request_response",
                "unknown"
              ]
            },
            "purpose": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/payload"
            },
            "response_payload": {
              "$ref": "#/$defs/payload"
            },
            "crosses_boundary": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "controls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "authentication": {
              "$ref": "#/$defs/authentication"
            },
            "encryption": {
              "$ref": "#/$defs/encryption"
            }
          }
        }
      ]
    },
    "entry_point": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "process",
            "protocol",
            "method",
            "path",
            "exposure",
            "controls",
            "call_chain",
            "reaches"
          ],
          "properties": {
            "process": {
              "$ref": "#/$defs/id"
            },
            "protocol": {
              "$ref": "#/$defs/protocol"
            },
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "description": "Full normalized path: mount prefixes and global prefix applied, parameters as {name}, no trailing slash"
            },
            "topic": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "controls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "Controls guarding this entry point, in registration (execution) order"
            },
            "call_chain": {
              "type": "array",
              "description": "Ordered process ids the request passes through; drives the control-flow view",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "infrastructure": {
              "type": "boolean",
              "description": "Health checks, CORS preflight, docs, metrics: real listeners, kept out of the main views and attack-surface counts"
            },
            "reaches": {
              "type": "array",
              "description": "Stores, external entities and services this entry point's handler reaches through its own call graph",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "code_name": {
              "type": "string",
              "description": "The code-derived name, kept when an override renames the element"
            },
            "exposure": {
              "type": "string",
              "enum": [
                "public",
                "internal",
                "unknown"
              ],
              "description": "public: published outside the deployment (compose port, LoadBalancer/NodePort/Ingress); internal: reachable only inside it; unknown: no deployment descriptor"
            }
          }
        }
      ]
    },
    "control": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name",
            "scope",
            "applies_to"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/control_kind"
            },
            "name": {
              "type": "string"
            },
            "applies_to": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "conditional": {
              "type": "boolean",
              "description": "Registered inside a condition (e.g. only in production); counted as applying, flagged for review"
            },
            "scope": {
              "type": "string",
              "enum": [
                "route",
                "router",
                "service",
                "handler"
              ],
              "description": "Where the control is registered"
            }
          }
        }
      ]
    },
    "data_schema": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "fields"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "data_class": {
                    "$ref": "#/$defs/data_class"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unresolved",
            "unsupported_file",
            "no_boundary_info",
            "override_target_missing",
            "unknown_attribute"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "weakness_kind": {
      "type": "string",
      "enum": [
        "plaintext_credentials",
        "tls_verification_disabled",
        "unencrypted_transport",
        "permissive_cors",
        "csrf_disabled",
        "public_data_store",
        "unencrypted_data_store",
        "debug_mode_enabled",
        "unauthenticated_entry_point"
      ]
    },
    "authentication": {
      "type": "string",
      "enum": [
        "none",
        "credentials",
        "session_id",
        "token",
        "client_certificate",
        "two_factor",
        "unknown"
      ],
      "description": "Threagile-compatible"
    },
    "encryption": {
      "type": "string",
      "enum": [
        "tls",
        "none",
        "unknown"
      ]
    },
    "encryption_at_rest": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "weakness": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name",
            "severity",
            "cwe",
            "stride",
            "applies_to"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/weakness_kind"
            },
            "name": {
              "type": "string"
            },
            "applies_to": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "severity": {
              "$ref": "#/$defs/severity"
            },
            "cwe": {
              "type": "string",
              "pattern": "^CWE-[0-9]+$"
            },
            "stride": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stride"
              }
            }
          }
        }
      ]
    },
    "asset_kind": {
      "type": "string",
      "enum": [
        "data",
        "credential",
        "key",
        "privileged_function",
        "system"
      ]
    },
    "asset": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "kind",
            "data_classes",
            "held_by",
            "processed_by"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/asset_kind"
            },
            "data_classes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/data_class"
              },
              "minItems": 1
            },
            "held_by": {
              "type": "array",
              "description": "Stores (or processes, for in-memory secrets) that hold the asset",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "processed_by": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "agent_access": {
      "type": "string",
      "enum": [
        "anonymous",
        "authenticated",
        "insider",
        "third_party",
        "physical"
      ]
    },
    "threat_agent": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenced"
        },
        {
          "type": "object",
          "required": [
            "name",
            "access",
            "entry",
            "passes_controls",
            "goals"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "access": {
              "$ref": "#/$defs/agent_access"
            },
            "location": {
              "$ref": "#/$defs/id",
              "description": "Boundary the agent sits in; absent means outside every boundary"
            },
            "entry": {
              "type": "array",
              "minItems": 1,
              "description": "Elements the agent can reach directly",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "passes_controls": {
              "type": "array",
              "description": "Control kinds this agent legitimately satisfies (an authenticated user passes authn)",
              "items": {
                "$ref": "#/$defs/control_kind"
              }
            },
            "goals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "stride": {
      "type": "string",
      "enum": [
        "S",
        "T",
        "R",
        "I",
